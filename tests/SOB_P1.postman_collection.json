        {
          "name": "GET prompts (ordenados por titulo)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/prompt",
              "host": [
                "{{base}}"
              ],
              "path": [
                "prompt"
              ],
              "query": []
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "var l=pm.response.json(); var t=l.map(function(p){return p.title;}); pm.test(\"ordenado por titulo\", function(){ pm.expect(t).to.eql(t.slice().sort()); });"
                ]
              }
            }
          ]
        },
